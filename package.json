{
  "name": "perde-ai-maskeleme",
  "version": "1.0.0",
  "description": "Hukuki evraklar için cihaz üzerinde çalışan kişisel veri maskeleme uygulaması",
  "author": "Baran Can Kaya",
  "private": true,
  "main": "desktop/electron.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop:build-web": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "npm run desktop:build-web && electron .",
    "desktop:package:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "desktop:package:win": "electron-builder --win nsis portable --x64 --publish never",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tesseract.js-data/tur": "^1.0.0",
    "docx": "^9.5.1",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "pdfmake": "^0.2.20",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "tr.perde.maskeleme",
    "productName": "Perde",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/electron.cjs"
    ],
    "extraResources": [
      {
        "from": "desktop-dist",
        "to": "desktop-dist"
      }
    ],
    "mac": {
      "artifactName": "Perde-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Perde-Kurulum-${version}-Windows-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Perde-Tasinabilir-${version}-Windows-${arch}.${ext}"
    }
  }
}
